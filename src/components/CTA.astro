---
export interface Props {
  calLink: string;
}
const { calLink } = Astro.props;
---

<section class="relative py-24 overflow-hidden">
  <div class="absolute inset-0 bg-blue-600"></div>
  <div
    class="absolute inset-0 bg-cover bg-center mix-blend-overlay opacity-20"
    style="background-image: url('https://images.unsplash.com/photo-1601362840469-51e4d8d58785?auto=format&fit=crop&q=80');"
  ></div>
  <div class="absolute inset-0 bg-gradient-to-t from-slate-950 to-transparent"></div>

  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-4xl md:text-6xl font-bold text-white mb-6 tracking-tight">
      <span class="lang-es">Devuélvele el brillo a tu auto hoy.</span>
      <span class="lang-en">Restore your car's shine today.</span>
    </h2>
    <p class="text-xl text-blue-100 mb-10 max-w-2xl mx-auto">
      <span class="lang-es">Reserva tu cita ahora y experimenta la diferencia del verdadero detallado premium.</span>
      <span class="lang-en">Reserve your appointment now and experience the difference of true premium detailing.</span>
    </p>
    <a
      href={calLink}
      class="inline-block px-10 py-5 bg-white text-blue-900 hover:bg-slate-100 font-bold text-lg rounded-xl transition-transform hover:scale-105 shadow-[0_0_30px_rgba(255,255,255,0.3)]"
    >
      <span class="lang-es">Reservar Ahora</span>
      <span class="lang-en">Reserve Now</span>
    </a>
  </div>
</section>
