---
export interface Props {
  calLink: string;
}
const { calLink } = Astro.props;
---

<section class="relative min-h-screen flex items-center pt-20 overflow-hidden">
  <!-- Background Image & Overlays -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1618843479313-40f8afb4b4d8?auto=format&fit=crop&q=80&w=2000"
      alt="Luxury Car Detailing"
      class="w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/80 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pt-20 pb-32">
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 backdrop-blur-md mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#eab308" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span class="text-xs font-semibold tracking-wider text-slate-300 uppercase">
          <span class="lang-es">Servicio Premium en USA</span>
          <span class="lang-en">Premium Service in the USA</span>
        </span>
      </div>

      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight text-white mb-6 leading-[1.1]">
        <span class="lang-es">Tu auto merece</span>
        <span class="lang-en">Your car deserves</span>
        <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-blue-600">
          <span class="lang-es">verse impecable.</span>
          <span class="lang-en">to look impeccable.</span>
        </span>
      </h1>

      <p class="text-lg md:text-xl text-slate-300 mb-10 leading-relaxed">
        <span class="lang-es">
          Detallado premium para proteger, restaurar y hacer brillar tu vehículo.
          Experimenta el estándar <span class="font-semibold text-white">Elite</span> en cuidado automotriz.
        </span>
        <span class="lang-en">
          Premium detailing to protect, restore, and make your vehicle shine.
          Experience the <span class="font-semibold text-white">Elite</span> standard in automotive care.
        </span>
      </p>

      <div class="flex flex-col sm:flex-row gap-4 mb-12">
        <a
          href={calLink}
          class="px-8 py-4 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl transition-all flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(37,99,235,0.4)] hover:shadow-[0_0_30px_rgba(37,99,235,0.6)] group"
        >
          <span class="lang-es">Agenda tu cita</span>
          <span class="lang-en">Book your appointment</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </a>
        <a
          href="#services"
          class="px-8 py-4 bg-white/5 hover:bg-white/10 border border-white/10 text-white font-semibold rounded-xl backdrop-blur-md transition-all flex items-center justify-center"
        >
          <span class="lang-es">Ver servicios</span>
          <span class="lang-en">View services</span>
        </a>
      </div>

      <!-- Trust Indicators -->
      <div class="flex items-center gap-6 text-sm text-slate-400 border-t border-white/10 pt-6">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <path d="m9 11 3 3L22 4"></path>
          </svg>
          <span class="lang-es">+500 Autos Detallados</span>
          <span class="lang-en">+500 Cars Detailed</span>
        </div>
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span class="lang-es">Servicio Móvil Disponible</span>
          <span class="lang-en">Mobile Service Available</span>
        </div>
      </div>
    </div>
  </div>
</section>
