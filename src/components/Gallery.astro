---
---

<section id="gallery" class="py-24 bg-black">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-5xl font-bold mb-12 text-center">
      <span class="lang-es">Nuestra <span class="text-blue-500">Galería</span></span>
      <span class="lang-en">Our <span class="text-blue-500">Gallery</span></span>
    </h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 auto-rows-[200px]">
      <div class="col-span-2 row-span-2 rounded-2xl overflow-hidden group relative">
        <img
          src="https://images.unsplash.com/photo-1549317661-bd32c8ce0db2?auto=format&fit=crop&q=80&w=800"
          alt="Porsche"
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-6">
          <span class="text-white font-semibold">Ceramic Coating - Porsche</span>
        </div>
      </div>
      <div class="rounded-2xl overflow-hidden group relative">
        <img
          src="https://images.unsplash.com/photo-1601362840469-51e4d8d58785?auto=format&fit=crop&q=80&w=400"
          alt="Detailing Action"
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
        />
      </div>
      <div class="rounded-2xl overflow-hidden group relative">
        <img
          src="https://images.unsplash.com/photo-1517524008697-84bbe3c3fd98?auto=format&fit=crop&q=80&w=400"
          alt="Interior Detail"
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
        />
      </div>
      <div class="col-span-2 rounded-2xl overflow-hidden group relative">
        <img
          src="https://images.unsplash.com/photo-1580274455135-2c8c4598d1a1?auto=format&fit=crop&q=80&w=800"
          alt="Luxury Car"
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
        />
      </div>
    </div>
  </div>
</section>
