---
const FAQS = [
  {
    es: {
      q: "¿Cuánto dura el servicio de detallado?",
      a: "Depende del paquete. Un detalle básico toma 2-3 horas, mientras que una corrección de pintura y ceramic coating puede tomar de 1 a 2 días completos.",
    },
    en: {
      q: "How long does the detailing service take?",
      a: "It depends on the package. A basic detail takes 2-3 hours, while a paint correction and ceramic coating can take 1 to 2 full days.",
    },
  },
  {
    es: {
      q: "¿Ofrecen servicio móvil?",
      a: "Sí, estamos completamente equipados con nuestra propia agua y electricidad para atenderte en tu domicilio o lugar de trabajo dentro de nuestra área de cobertura.",
    },
    en: {
      q: "Do you offer mobile service?",
      a: "Yes, we are fully equipped with our own water and electricity to serve you at your home or workplace within our coverage area.",
    },
  },
  {
    es: {
      q: "¿Cuánto dura el Ceramic Coating?",
      a: "Ofrecemos paquetes de recubrimiento cerámico que van desde 1 año hasta 5 años de protección, dependiendo de la fórmula elegida y el mantenimiento posterior.",
    },
    en: {
      q: "How long does Ceramic Coating last?",
      a: "We offer ceramic coating packages ranging from 1 year to 5 years of protection, depending on the formula chosen and subsequent maintenance.",
    },
  },
  {
    es: {
      q: "¿Atienden SUVs grandes y Trucks?",
      a: "¡Por supuesto! Atendemos todo tipo de vehículos. Ten en cuenta que vehículos más grandes pueden tener un costo adicional debido al tiempo y materiales extra requeridos.",
    },
    en: {
      q: "Do you service large SUVs and Trucks?",
      a: "Absolutely! We service all types of vehicles. Keep in mind that larger vehicles may have an additional cost due to the extra time and materials required.",
    },
  },
];
---

<section class="py-24 bg-slate-950">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-center mb-12">
      <span class="lang-es">Preguntas <span class="text-blue-500">Frecuentes</span></span>
      <span class="lang-en">Frequently Asked <span class="text-blue-500">Questions</span></span>
    </h2>
    <div class="border-t border-slate-800">
      {FAQS.map((faq, i) => (
        <div class="faq-item border-b border-slate-800">
          <button
            class="faq-trigger w-full py-6 flex justify-between items-center text-left focus:outline-none"
            aria-expanded="false"
            aria-controls={`faq-answer-${i}`}
          >
            <h4 class="text-lg font-medium text-slate-200">
              <span class="lang-es">{faq.es.q}</span>
              <span class="lang-en">{faq.en.q}</span>
            </h4>
            <svg
              class="faq-chevron w-5 h-5 text-blue-500 transition-transform duration-300 shrink-0 ml-4"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>
          <div
            id={`faq-answer-${i}`}
            class="faq-answer overflow-hidden max-h-0 opacity-0 transition-all duration-300"
          >
            <p class="text-slate-400 pb-6 lang-es">{faq.es.a}</p>
            <p class="text-slate-400 pb-6 lang-en">{faq.en.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.faq-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-item')!;
      const answer = item.querySelector<HTMLElement>('.faq-answer')!;
      const chevron = trigger.querySelector<SVGElement>('.faq-chevron')!;
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      trigger.setAttribute('aria-expanded', String(!isOpen));
      if (isOpen) {
        answer.style.maxHeight = '0';
        answer.classList.remove('opacity-100', 'pb-0');
        answer.classList.add('opacity-0');
        chevron.style.transform = '';
      } else {
        answer.style.maxHeight = answer.scrollHeight + 'px';
        answer.classList.remove('opacity-0');
        answer.classList.add('opacity-100');
        chevron.style.transform = 'rotate(180deg)';
      }
    });
  });
</script>
