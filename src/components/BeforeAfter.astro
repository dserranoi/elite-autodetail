---
import BeforeAfterSlider from './BeforeAfterSlider.tsx';
---

<section class="py-24 bg-slate-900 relative border-y border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold mb-6">
        <span class="lang-es">Resultados <span class="text-blue-500">Impactantes</span></span>
        <span class="lang-en">Stunning <span class="text-blue-500">Results</span></span>
      </h2>
      <p class="text-slate-400 text-lg">
        <span class="lang-es">Desliza para ver la transformación. Restauramos la profundidad del color y eliminamos imperfecciones.</span>
        <span class="lang-en">Slide to see the transformation. We restore color depth and eliminate imperfections.</span>
      </p>
    </div>

    <BeforeAfterSlider client:load />
  </div>
</section>
