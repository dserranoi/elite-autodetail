---
export interface Props {
  businessName: string;
  phone: string;
  email: string;
  location: string;
  hours: string;
  instagram: string;
  facebook: string;
}
const { businessName, phone, email, location, hours, instagram, facebook } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-slate-950 pt-16 pb-8 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <!-- Brand -->
      <div class="col-span-1 md:col-span-1">
        <div class="flex items-center gap-2 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
            <path d="M5 3v4"></path><path d="M19 17v4"></path><path d="M3 5h4"></path><path d="M17 19h4"></path>
          </svg>
          <span class="text-xl font-bold text-white uppercase">
            {businessName.replace('Detail', '')}<span class="text-blue-500">Detail</span>
          </span>
        </div>
        <p class="text-slate-400 text-sm mb-6">
          <span class="lang-es">Transformamos tu auto como nuevo. Servicio premium de detallado móvil y en taller.</span>
          <span class="lang-en">We transform your car like new. Premium mobile and shop detailing service.</span>
        </p>
        <div class="flex space-x-4">
          <a href={instagram} class="text-slate-400 hover:text-white transition-colors" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
          </a>
          <a href={facebook} class="text-slate-400 hover:text-white transition-colors" aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Services Links -->
      <div>
        <h4 class="text-white font-semibold mb-4">
          <span class="lang-es">Servicios</span>
          <span class="lang-en">Services</span>
        </h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href="#" class="hover:text-blue-400 transition-colors">Interior Detailing</a></li>
          <li><a href="#" class="hover:text-blue-400 transition-colors">Exterior Detailing</a></li>
          <li><a href="#" class="hover:text-blue-400 transition-colors">Ceramic Coating</a></li>
          <li><a href="#" class="hover:text-blue-400 transition-colors">Paint Correction</a></li>
        </ul>
      </div>

      <!-- Company Links -->
      <div>
        <h4 class="text-white font-semibold mb-4">
          <span class="lang-es">Empresa</span>
          <span class="lang-en">Company</span>
        </h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li>
            <a href="#" class="hover:text-blue-400 transition-colors">
              <span class="lang-es">Sobre Nosotros</span>
              <span class="lang-en">About Us</span>
            </a>
          </li>
          <li>
            <a href="#gallery" class="hover:text-blue-400 transition-colors">
              <span class="lang-es">Galería</span>
              <span class="lang-en">Gallery</span>
            </a>
          </li>
          <li>
            <a href="#pricing" class="hover:text-blue-400 transition-colors">
              <span class="lang-es">Precios</span>
              <span class="lang-en">Pricing</span>
            </a>
          </li>
          <li>
            <a href="#" class="hover:text-blue-400 transition-colors">
              <span class="lang-es">Términos y Condiciones</span>
              <span class="lang-en">Terms &amp; Conditions</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-white font-semibold mb-4">
          <span class="lang-es">Contacto</span>
          <span class="lang-en">Contact</span>
        </h4>
        <ul class="space-y-3 text-sm text-slate-400">
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.63 3.35 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.6a16 16 0 0 0 6.29 6.29l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            {phone}
          </li>
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            {email}
          </li>
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            {location} (Mobile Service)
          </li>
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            {hours}
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center text-xs text-slate-500">
      <p>
        &copy; {year} {businessName}.
        <span class="lang-es">Todos los derechos reservados.</span>
        <span class="lang-en">All rights reserved.</span>
      </p>
      <p class="mt-2 md:mt-0">
        <span class="lang-es">Diseñado para conversiones.</span>
        <span class="lang-en">Designed for conversions.</span>
      </p>
    </div>
  </div>
</footer>
